generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Temp_users {
  user_id String? @db.Uuid

  @@ignore
}

model activity_log {
  id          Int       @id @default(autoincrement())
  user_id     String    @db.Uuid
  log_type    Int
  description Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  modified_at DateTime? @default(now()) @db.Timestamp(6)
  created_by  String?   @db.Uuid
  modified_by String?   @db.Uuid
}

model app_constants {
  id                                                        Int             @id @default(autoincrement())
  status                                                    String          @default("draft") @db.VarChar(255)
  sort                                                      Int?
  user_created                                              String?         @db.Uuid
  date_created                                              DateTime?       @db.Timestamptz(6)
  user_updated                                              String?         @db.Uuid
  date_updated                                              DateTime?       @db.Timestamptz(6)
  name                                                      String?         @db.VarChar(255)
  slug                                                      String?         @unique(map: "app_constants_slug_unique") @db.VarChar(255)
  value                                                     String?         @db.VarChar(255)
  response_json_data                                        Json?
  directus_users_app_constants_user_createdTodirectus_users directus_users? @relation("app_constants_user_createdTodirectus_users", fields: [user_created], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "app_constants_user_created_foreign")
  directus_users_app_constants_user_updatedTodirectus_users directus_users? @relation("app_constants_user_updatedTodirectus_users", fields: [user_updated], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "app_constants_user_updated_foreign")
}

model app_installation {
  id             Int            @id @default(autoincrement())
  user_id        String         @db.Uuid
  fcm_id         String         @unique
  device_id      String?
  platform       Int?           @default(1) @db.SmallInt
  active         Boolean?       @default(true)
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?      @default(now()) @db.Timestamptz(6)
  directus_users directus_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_app_installation_directus_users")
}

model app_version {
  id                                                      Int             @id @default(autoincrement())
  status                                                  String          @default("draft") @db.VarChar(255)
  sort                                                    Int?
  user_created                                            String?         @db.Uuid
  date_created                                            DateTime?       @db.Timestamptz(6)
  user_updated                                            String?         @db.Uuid
  date_updated                                            DateTime?       @db.Timestamptz(6)
  user_os                                                 String?         @db.VarChar(255)
  latest_version                                          String?         @db.VarChar(255)
  last_compulsory_version                                 String?         @db.VarChar(255)
  is_compulsory                                           String?         @db.VarChar(255)
  directus_users_app_version_user_createdTodirectus_users directus_users? @relation("app_version_user_createdTodirectus_users", fields: [user_created], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "app_version_user_created_foreign")
  directus_users_app_version_user_updatedTodirectus_users directus_users? @relation("app_version_user_updatedTodirectus_users", fields: [user_updated], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "app_version_user_updated_foreign")
}

model audit_trail {
  id         Int       @id @default(autoincrement())
  action     String    @db.VarChar(45)
  user_id    String?   @db.Uuid
  timestamp  DateTime? @default(now()) @db.Timestamptz(6)
  ip         String?   @db.VarChar(50)
  user_agent String?   @db.VarChar(512)
  collection String    @db.VarChar(64)
  item       String?   @db.VarChar(255)
  comment    String?
  origin     String?   @db.VarChar(255)
  metadata   Json?
}

model change_location_escalation_log {
  id                         Int                     @id @default(autoincrement())
  change_location_request_id Int
  stage                      Int                     @db.SmallInt
  is_notify                  Int                     @db.SmallInt
  created_at                 DateTime                @default(now()) @db.Timestamptz(6)
  change_location_request    change_location_request @relation(fields: [change_location_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_escalation_log_request")

  @@index([created_at], map: "idx_escalation_log_created_at")
  @@index([change_location_request_id], map: "idx_escalation_log_request_id")
}

/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model change_location_request {
  id                                                                           Int                                @id @default(autoincrement())
  guid                                                                         String                             @unique @db.Uuid
  user_id                                                                      String                             @db.Uuid
  role                                                                         String                             @db.Uuid
  current_state_id                                                             Int
  target_state_id                                                              Int
  current_district_id                                                          Int?
  target_district_id                                                           Int?
  current_block_id                                                             Int?
  target_block_id                                                              Int?
  current_school_id                                                            Int?
  target_school_id                                                             Int?
  approved_date                                                                DateTime?                          @db.Timestamptz(6)
  rejected_date                                                                DateTime?                          @db.Timestamptz(6)
  reason                                                                       String?
  status                                                                       Int?                               @default(1) @db.SmallInt
  created_by                                                                   String                             @db.Uuid
  updated_by                                                                   String?                            @db.Uuid
  created_at                                                                   DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                                                                   DateTime?                          @db.Timestamptz(6)
  new_role_id                                                                  String?                            @db.Uuid
  change_location_escalation_log                                               change_location_escalation_log[]
  directus_roles_change_location_request_roleTodirectus_roles                  directus_roles                     @relation("change_location_request_roleTodirectus_roles", fields: [role], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "change_location_request_role_foreign")
  directus_users_change_location_request_created_byTodirectus_users            directus_users                     @relation("change_location_request_created_byTodirectus_users", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_change_location_created_by")
  mst_block_udise_change_location_request_current_block_idTomst_block_udise    mst_block_udise?                   @relation("change_location_request_current_block_idTomst_block_udise", fields: [current_block_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_current_block")
  master_district_change_location_request_current_district_idTomaster_district master_district?                   @relation("change_location_request_current_district_idTomaster_district", fields: [current_district_id], references: [district_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_current_district")
  master_schools_change_location_request_current_school_idTomaster_schools     master_schools?                    @relation("change_location_request_current_school_idTomaster_schools", fields: [current_school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_current_school")
  master_state_change_location_request_current_state_idTomaster_state          master_state                       @relation("change_location_request_current_state_idTomaster_state", fields: [current_state_id], references: [state_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_current_state")
  directus_roles_change_location_request_new_role_idTodirectus_roles           directus_roles?                    @relation("change_location_request_new_role_idTodirectus_roles", fields: [new_role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_change_location_new_role")
  mst_block_udise_change_location_request_target_block_idTomst_block_udise     mst_block_udise?                   @relation("change_location_request_target_block_idTomst_block_udise", fields: [target_block_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_target_block")
  master_district_change_location_request_target_district_idTomaster_district  master_district?                   @relation("change_location_request_target_district_idTomaster_district", fields: [target_district_id], references: [district_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_target_district")
  master_schools_change_location_request_target_school_idTomaster_schools      master_schools?                    @relation("change_location_request_target_school_idTomaster_schools", fields: [target_school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_target_school")
  master_state_change_location_request_target_state_idTomaster_state           master_state                       @relation("change_location_request_target_state_idTomaster_state", fields: [target_state_id], references: [state_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_target_state")
  directus_users_change_location_request_updated_byTodirectus_users            directus_users?                    @relation("change_location_request_updated_byTodirectus_users", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_change_location_updated_by")
  directus_users_change_location_request_user_idTodirectus_users               directus_users                     @relation("change_location_request_user_idTodirectus_users", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_change_location_user_id")
  change_location_request_activity                                             change_location_request_activity[]

  @@index([created_at], map: "idx_change_location_request_created_at")
  @@index([current_block_id], map: "idx_change_location_request_current_block_id")
  @@index([current_district_id], map: "idx_change_location_request_current_district_id")
  @@index([current_school_id], map: "idx_change_location_request_current_school_id")
  @@index([current_state_id], map: "idx_change_location_request_current_state_id")
  @@index([status], map: "idx_change_location_request_status")
  @@index([status, created_at(sort: Desc)], map: "idx_change_location_request_status_created_at")
  @@index([target_block_id], map: "idx_change_location_request_target_block_id")
  @@index([target_district_id], map: "idx_change_location_request_target_district_id")
  @@index([target_school_id], map: "idx_change_location_request_target_school_id")
  @@index([target_state_id], map: "idx_change_location_request_target_state_id")
  @@index([user_id], map: "idx_change_location_request_user_id")
}

model change_location_request_activity {
  id                         Int                     @id @default(autoincrement())
  change_location_request_id Int
